{
  "name": "tobira",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-clean.sh && pnpm -C frontend dev",
    "dev:clean": "bash scripts/dev-clean.sh",
    "build": "pnpm -C frontend build",
    "lint": "pnpm -C frontend lint",
    "test": "pnpm -C frontend test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
